---
/**
 * Rodape unico do site.
 *
 * Antes havia DOIS: o do index (.footer, com estilo) e o das paginas de artigo
 * (.site-footer + .footer__grid), que nao tinha CSS nenhum e aparecia sem
 * formatacao. Sobrou o do index — o unico que o styles.css conhece.
 */
import { SITE, RODAPE_NAV } from '../data/site.js'

const ano = new Date().getFullYear()
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <a href="/" class="brand" style="margin-bottom:16px">
          <img src="/assets/img/logo-light.png" alt="Logo PGC" class="brand__logo" width="120" height="34" />
        </a>
        <p class="muted measure-sm" style="font-size:.9rem">
          Plataforma de Gestão Comercial. A infraestrutura que transforma um negócio artesanal em uma empresa estruturada.
        </p>
        <div class="socials" style="margin-top:20px">
          <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
          <a href="#" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l5 3-5 3z" fill="currentColor"/></svg></a>
          <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4M11 17v-7"/></svg></a>
        </div>
      </div>
      <div>
        <h5>Navegação</h5>
        {RODAPE_NAV.map((i) => (<><a href={i.href}>{i.label}</a><br /></>))}
        <a href="/blog">Blog</a>
      </div>
      <div>
        <h5>Legal &amp; Contato</h5>
        <a href="#" data-edit="link-privacidade">Política de privacidade</a><br />
        <a href="#" data-edit="link-termos">Termos de uso</a><br />
        <a href="#" data-edit="link-cancelamento">Política de cancelamento</a><br />
        <a href="#" data-edit="link-avisos">Avisos legais</a><br />
        <a href={`mailto:${SITE.email}`} data-edit="email-contato">{SITE.email}</a><br />
        <a href={SITE.whatsapp} data-edit="whatsapp" data-cta="footer-whatsapp">WhatsApp comercial</a><br />
        <a href="/llms.txt" target="_blank">llms.txt</a>
      </div>
    </div>
    <div class="footer__legal">
      <p>
        <span class="editable" data-edit="razao-social">{SITE.razaoSocial}</span> ·
        CNPJ <span class="editable" data-edit="cnpj">{SITE.cnpj}</span> ·
        © {ano} PGC. Todos os direitos reservados.
      </p>
      <p class="fine">As informações desta página são ilustrativas. Resultados variam conforme oferta, execução e mercado.</p>
    </div>
  </div>
</footer>
